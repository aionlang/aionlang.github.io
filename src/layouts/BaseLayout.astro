---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'docs' | 'downloads';
}

const {
  title,
  description = 'Aion is a statically typed, garbage-collected language that reads like a script and compiles to a native binary through LLVM.',
  activeNav = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/assets/aionsmall.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ViewTransitions />
  </head>
  <body class="bg-[#131313] text-neutral-200 min-h-screen flex flex-col">
    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 bg-[#131313] border-b border-[#2c2c2c]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-14 gap-4">
          <!-- Static Inline SVG Brand Logo (persisted across navigations) -->
          <div class="flex items-center gap-6">
            <a href="/" transition:persist="aion-brand-logo" class="flex items-center gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="73 15 2411 850"
                class="h-7 w-auto"
                role="img"
                aria-label="Aion"
              >
                <path
                  fill="#4377df"
                  fill-rule="evenodd"
                  d="M73 15H817L598 344H292ZM292 445H598L817 865H649L622 814H267L241 865H73ZM405 550L323 707H566L484 550Z"
                />
                <g fill="#81a3e8">
                  <rect x="863" y="435" width="167" height="420" />
                  <path
                    fill-rule="evenodd"
                    d="M1208 435H1685A85 85 0 0 1 1770 520V770A85 85 0 0 1 1685 855H1208A85 85 0 0 1 1123 770V520A85 85 0 0 1 1208 435ZM1332 540A42 42 0 0 0 1290 582V708A42 42 0 0 0 1332 750H1561A42 42 0 0 0 1603 708V582A42 42 0 0 0 1561 540Z"
                  />
                  <path d="M1862 435H2055L2316 690V435H2484V855H2292L2030 598V855H1862Z" />
                </g>
              </svg>
              <span class="text-xs font-mono text-neutral-400 border border-[#333333] bg-[#1c1c1c] px-1.5 py-0.5 rounded">
                0.3.0
              </span>
            </a>

            <!-- Quick Section Links on Desktop -->
            <div class="hidden lg:flex items-center space-x-1 text-sm text-neutral-400 border-l border-[#2c2c2c] pl-5">
              <a href="/documentation/syntax" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Syntax</a>
              <a href="/documentation/types" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Types</a>
              <a href="/documentation/functions" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Functions</a>
              <a href="/documentation/prelude-methods" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Prelude</a>
              <a href="/documentation/stdlib" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Stdlib</a>
              <a href="/documentation/errors-and-concurrency" class="px-2.5 py-1 rounded hover:text-white hover:bg-[#1f1f1f] transition-colors">Concurrency</a>
            </div>
          </div>

          <!-- Right Nav -->
          <nav class="flex items-center space-x-2 sm:space-x-5 text-sm">
            <a
              href="/"
              class={`px-2.5 py-1 rounded transition-colors ${
                activeNav === 'home' ? 'text-white font-medium bg-[#222222]' : 'text-neutral-400 hover:text-white'
              }`}
            >
              Home
            </a>
            <a
              href="/documentation"
              class={`px-2.5 py-1 rounded transition-colors ${
                activeNav === 'docs' ? 'text-white font-medium bg-[#222222]' : 'text-neutral-400 hover:text-white'
              }`}
            >
              Documentation
            </a>
            <a
              href="/downloads"
              class={`px-2.5 py-1 rounded transition-colors ${
                activeNav === 'downloads' ? 'text-white font-medium bg-[#222222]' : 'text-neutral-400 hover:text-white'
              }`}
            >
              Downloads
            </a>
            <a
              href="https://github.com/aionlang/aion"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-neutral-400 hover:text-white transition-colors"
            >
              <span>GitHub</span>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#262626] bg-[#111111] py-10 mt-16">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 text-xs text-neutral-500">
        <div class="flex items-center gap-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="73 15 2411 850"
            class="h-5 w-auto opacity-80"
            role="img"
            aria-label="Aion"
          >
            <path
              fill="#4377df"
              fill-rule="evenodd"
              d="M73 15H817L598 344H292ZM292 445H598L817 865H649L622 814H267L241 865H73ZM405 550L323 707H566L484 550Z"
            />
            <g fill="#81a3e8">
              <rect x="863" y="435" width="167" height="420" />
              <path
                fill-rule="evenodd"
                d="M1208 435H1685A85 85 0 0 1 1770 520V770A85 85 0 0 1 1685 855H1208A85 85 0 0 1 1123 770V520A85 85 0 0 1 1208 435ZM1332 540A42 42 0 0 0 1290 582V708A42 42 0 0 0 1332 750H1561A42 42 0 0 0 1603 708V582A42 42 0 0 0 1561 540Z"
              />
              <path d="M1862 435H2055L2316 690V435H2484V855H2292L2030 598V855H1862Z" />
            </g>
          </svg>
          <span>Aion v0.3.0 • Apache License 2.0</span>
        </div>

        <div class="flex flex-wrap gap-5 text-neutral-400">
          <a href="/documentation/getting-started" class="hover:text-white">CLI &amp; REPL</a>
          <a href="/documentation/syntax" class="hover:text-white">Syntax</a>
          <a href="/documentation/types" class="hover:text-white">Types</a>
          <a href="/documentation/prelude-methods" class="hover:text-white">Prelude</a>
          <a href="/documentation/stdlib" class="hover:text-white">Stdlib</a>
          <a href="/downloads" class="hover:text-white">Downloads</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Copy code button handler
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-copy-code]');
        if (!btn) return;
        const wrapper = btn.closest('.code-block-wrapper');
        const codeEl = wrapper ? wrapper.querySelector('code') : null;
        if (!codeEl) return;
        navigator.clipboard.writeText(codeEl.innerText).then(() => {
          const orig = btn.innerText;
          btn.innerText = 'Copied';
          setTimeout(() => {
            btn.innerText = orig;
          }, 1200);
        });
      });
    </script>
  </body>
</html>
