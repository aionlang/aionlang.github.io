---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const heroTabs = [
  {
    id: 'tour',
    label: 'tour.aion',
    title: 'tour.aion',
    code: `import math

type Shape(name: String, sides: Int = 0) {
    fn describe() = if sides == 0 { "$name (round)" } else { "$name with $sides sides" }
}

println(Shape("square", sides: 4).describe())

for r in 1..=3 {
    println("radius $r -> area \${(math.pi * r * r).format(2)}")
}

fn twice(f: (Int) -> Int) = { x: Int -> f(f(x)) }
println("twice *3 on 2 =", twice { it * 3 }(2))`,
    output: `square with 4 sides
radius 1 -> area 3.14
radius 2 -> area 12.57
radius 3 -> area 28.27
twice *3 on 2 = 18`,
  },
  {
    id: 'types',
    label: 'interfaces.aion',
    title: 'interfaces.aion',
    code: `interface Shape {
    fn area() -> Float
    fn name() -> String
    fn summary() -> String = "\${name()}: \${area().format(2)}"
}

data type Circle(r: Float) {
    fn area() = 3.14159 * r * r
    fn name() = "circle"
}

data type Rect(w: Float, h: Float) {
    fn area() = w * h
    fn name() = "rect"
}

fn totalArea<T: Shape>(items: List<T>) = items.fold(0.0) { sum, s -> sum + s.area() }

shapes: List<Shape> = [Circle(2.0), Rect(3.0, 4.0)]
for s in shapes { println(s.summary()) }
println("Total:", totalArea(shapes).format(2))`,
    output: `circle: 12.57
rect: 12.00
Total: 24.57`,
  },
  {
    id: 'concurrency',
    label: 'tasks.aion',
    title: 'tasks.aion',
    code: `jobs := Channel<Int>(10)
results := Channel<Int>(10)

workers := (1..=3).map { w ->
    launch {
        jobs.forEach { n -> results.send(n * n) }
    }
}

for n in 1..=6 { jobs.send(n) }
jobs.close()
for w in workers { w.join() }
results.close()

println("Squares:", results.drain().sorted())`,
    output: `Squares: [1, 4, 9, 16, 25, 36]`,
  },
  {
    id: 'streams',
    label: 'streams.aion',
    title: 'streams.aion',
    code: `fn parseScore(line: String) -> Result<(String, Int), String> {
    parts := line.split(":")
    if parts.size() != 2 { return Err("bad line: $line") }
    score := parts[1].trim().toIntOrNull() ?: return Err("not an int")
    return Ok((parts[0].trim(), score))
}

raw := ["ann: 92", "bob: 78", "cy: 95", "dee: 84"]
parsed := raw.map { parseScore(it).unwrap() }

top := parsed.stream()
    .filter { it.second >= 80 }
    .sortedBy { -it.second }
    .map { "\${it.first} (\${it.second})" }
    .joining(", ")

println("Honors:", top)`,
    output: `Honors: cy (95), ann (92), dee (84)`,
  },
  {
    id: 'http',
    label: 'http.aion',
    title: 'http.aion',
    code: `import http
import json

server := http.listen(0, "127.0.0.1") { req ->
    if req.path == "/api/user" {
        out := json.object()
        out["user"] = json.string(req.param("name") ?: "guest")
        out["active"] = json.bool(true)
        http.jsonResponse(out)
    } else {
        http.notFound()
    }
}!!
defer server.close()

res := http.get("http://127.0.0.1:\${server.port()}/api/user?name=Ada")!!
println(res.status, res.text())`,
    output: `200 {"user":"Ada","active":true}`,
  },
];
---

<BaseLayout title="Aion Programming Language" activeNav="home">
  <!-- Hero Section -->
  <section class="border-b border-[#262626] bg-[#161616] py-14 lg:py-20">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Left Column -->
        <div class="lg:col-span-5 space-y-5 pt-2">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
            Aion Programming Language
          </h1>

          <p class="text-base text-neutral-300 leading-relaxed">
            A statically typed, garbage-collected language that reads like a script and compiles to a native binary through LLVM and Clang.
          </p>

          <p class="text-sm text-neutral-400 leading-relaxed">
            No <code class="font-mono text-neutral-200 bg-[#222222] px-1.5 py-0.5 rounded border border-[#333]">main</code> boilerplate, no semicolons, and local type inference with <code class="font-mono text-neutral-200 bg-[#222222] px-1.5 py-0.5 rounded border border-[#333]">:=</code>. Includes monomorphized generics, structural interfaces, nullable types with smart casts, cooperative tasks, OS threads, and 25 standard library modules.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/documentation"
              class="px-5 py-2.5 rounded bg-[#4377df] hover:bg-[#3664c2] text-white text-sm font-medium transition-colors"
            >
              Documentation
            </a>
            <a
              href="/downloads"
              class="px-5 py-2.5 rounded bg-[#242424] hover:bg-[#2e2e2e] text-neutral-200 text-sm font-medium border border-[#363636] transition-colors"
            >
              Downloads
            </a>
          </div>

          <!-- Quick Reference Links -->
          <div class="pt-5 border-t border-[#262626]">
            <div class="text-xs font-mono text-neutral-500 mb-2">Language Reference:</div>
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              <a href="/documentation/syntax" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Syntax</a>
              <a href="/documentation/types" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Types &amp; Generics</a>
              <a href="/documentation/functions" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Functions</a>
              <a href="/documentation/prelude-methods" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Prelude Methods</a>
              <a href="/documentation/stdlib" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Stdlib (std.*)</a>
              <a href="/documentation/errors-and-concurrency" class="px-2.5 py-1 rounded bg-[#1f1f1f] hover:bg-[#282828] border border-[#2e2e2e] text-neutral-300">Tasks &amp; Threads</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Code Examples -->
        <div class="lg:col-span-7">
          <div class="rounded-lg border border-[#2c2c2c] bg-[#141414] overflow-hidden">
            <div class="flex overflow-x-auto border-b border-[#2c2c2c] bg-[#1c1c1c] px-2 pt-1.5 gap-1">
              {heroTabs.map((tab, idx) => (
                <button
                  type="button"
                  data-tab-target={tab.id}
                  class={`px-3 py-1.5 text-xs font-mono rounded-t border-b-2 whitespace-nowrap transition-colors ${
                    idx === 0
                      ? 'border-[#4377df] text-white bg-[#141414]'
                      : 'border-transparent text-neutral-400 hover:text-neutral-200'
                  }`}
                >
                  {tab.label}
                </button>
              ))}
            </div>

            <div class="p-3">
              {heroTabs.map((tab, idx) => (
                <div
                  data-tab-panel={tab.id}
                  class={idx === 0 ? 'block' : 'hidden'}
                >
                  <CodeBlock code={tab.code} title={tab.title} output={tab.output} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Sections -->
  <section class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-white mb-8">Overview of Aion</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href="/documentation/syntax" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Scripting Syntax</h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            Files run top to bottom without a <code class="text-xs font-mono text-neutral-200">main</code> wrapper. Variables use <code class="text-xs font-mono text-neutral-200">:=</code> for type inference and <code class="text-xs font-mono text-neutral-200">val</code> for constants. Includes <code class="text-xs font-mono text-neutral-200">when</code> expressions, <code class="text-xs font-mono text-neutral-200">1..=10 step 2</code> ranges, and <code class="text-xs font-mono text-neutral-200">"$name"</code> interpolation.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Syntax &amp; Operators &rarr;</span>
      </a>

      <a href="/documentation/types" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Static Types &amp; Generics</h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            Reference <code class="text-xs font-mono text-neutral-200">type</code> declarations, value-compared <code class="text-xs font-mono text-neutral-200">data type</code>, <code class="text-xs font-mono text-neutral-200">enum</code> variants with fields, structural <code class="text-xs font-mono text-neutral-200">interface</code> satisfaction, <code class="text-xs font-mono text-neutral-200">open type</code> inheritance, and monomorphized generics.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Types &amp; Generics &rarr;</span>
      </a>

      <a href="/documentation/types#nullability" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Nullability &amp; <code class="font-mono text-sm">Result&lt;T, E&gt;</code></h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            Optional types (<code class="text-xs font-mono text-neutral-200">T?</code>) with safe calls <code class="text-xs font-mono text-neutral-200">?.</code>, fallback <code class="text-xs font-mono text-neutral-200">?:</code>, early exits <code class="text-xs font-mono text-neutral-200">?: return</code>, and flow-sensitive smart casts, alongside <code class="text-xs font-mono text-neutral-200">Result&lt;T, E&gt;</code> and postfix <code class="text-xs font-mono text-neutral-200">?</code>.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Nullability &amp; Errors &rarr;</span>
      </a>

      <a href="/documentation/functions" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Functions, Closures &amp; Streams</h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            First-class closures <code class="text-xs font-mono text-neutral-200">{'{'} it * 2 {'}'}</code>, default and named parameters, <code class="text-xs font-mono text-neutral-200">vararg</code> with <code class="text-xs font-mono text-neutral-200">*xs</code> list spreading, overloading, extension methods on built-ins, and lazy <code class="text-xs font-mono text-neutral-200">Stream&lt;T&gt;</code> pipelines.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Functions &amp; Closures &rarr;</span>
      </a>

      <a href="/documentation/errors-and-concurrency" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Tasks, Channels &amp; OS Threads</h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            Cooperative <code class="text-xs font-mono text-neutral-200">launch</code> and <code class="text-xs font-mono text-neutral-200">async</code> tasks on 256 KiB stacks, <code class="text-xs font-mono text-neutral-200">Channel&lt;T&gt;</code> with <code class="text-xs font-mono text-neutral-200">select</code> multiplexing, and parallel OS <code class="text-xs font-mono text-neutral-200">thread</code> / <code class="text-xs font-mono text-neutral-200">compute</code> with <code class="text-xs font-mono text-neutral-200">Mutex</code> and <code class="text-xs font-mono text-neutral-200">AtomicInt</code>.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Concurrency Reference &rarr;</span>
      </a>

      <a href="/documentation/stdlib" class="p-5 rounded-lg bg-[#1b1b1b] border border-[#2c2c2c] hover:border-[#444444] transition-colors flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-white mb-2">Standard Library &amp; C FFI</h3>
          <p class="text-sm text-neutral-400 leading-relaxed mb-4">
            25 built-in modules (<code class="text-xs font-mono text-neutral-200">http</code>, <code class="text-xs font-mono text-neutral-200">http2</code>, <code class="text-xs font-mono text-neutral-200">websocket</code>, <code class="text-xs font-mono text-neutral-200">json</code>, <code class="text-xs font-mono text-neutral-200">sqlite</code>, <code class="text-xs font-mono text-neutral-200">regex</code>, <code class="text-xs font-mono text-neutral-200">crypto</code>, <code class="text-xs font-mono text-neutral-200">fs</code>, <code class="text-xs font-mono text-neutral-200">xml</code>, <code class="text-xs font-mono text-neutral-200">bigint</code>, <code class="text-xs font-mono text-neutral-200">archive</code>) plus single-line <code class="text-xs font-mono text-neutral-200">extern fn</code> C bindings.
          </p>
        </div>
        <span class="text-xs font-mono text-[#81a3e8]">Standard Library &rarr;</span>
      </a>
    </div>
  </section>

  <!-- Compiler Architecture Summary -->
  <section class="border-t border-[#262626] bg-[#161616] py-14">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5 space-y-3">
          <h2 class="text-2xl font-bold text-white">How It Works</h2>
          <p class="text-sm text-neutral-400 leading-relaxed">
            The compiler emits LLVM IR as text and invokes <code class="text-xs font-mono text-neutral-200">clang -O2</code>, removing any dependency on a specific LLVM version or LLVM development libraries. The runtime (precise mark-sweep garbage collector with shadow stack, strings, and task scheduler) is embedded directly in the compiler binary.
          </p>
          <div class="pt-2">
            <a href="/documentation/packages-and-ffi#architecture" class="text-xs font-mono text-[#81a3e8] hover:underline">
              Compiler &amp; GC Architecture &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="p-4 rounded-lg bg-[#121212] border border-[#2c2c2c] font-mono text-xs text-neutral-300 space-y-2">
            <div class="flex justify-between p-2.5 rounded bg-[#1a1a1a] border border-[#282828]">
              <span class="text-white">source.aion</span>
              <span class="text-neutral-400">src/syntax/ (lexer + recursive-descent parser)</span>
            </div>
            <div class="flex justify-between p-2.5 rounded bg-[#1a1a1a] border border-[#282828]">
              <span class="text-white">modules &amp; packages</span>
              <span class="text-neutral-400">src/loader.rs, src/project.rs (imports, git deps)</span>
            </div>
            <div class="flex justify-between p-2.5 rounded bg-[#1a1a1a] border border-[#282828]">
              <span class="text-white">typed IR (HIR)</span>
              <span class="text-neutral-400">src/sema/ (type checking, smart casts, monomorphization)</span>
            </div>
            <div class="flex justify-between p-2.5 rounded bg-[#1a1a1a] border border-[#282828]">
              <span class="text-white">program.ll &rarr; native executable</span>
              <span class="text-neutral-400">src/codegen.rs + clang -O2 (cached in ~4ms)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const tabButtons = document.querySelectorAll('[data-tab-target]');
      const tabPanels = document.querySelectorAll('[data-tab-panel]');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab-target');
          tabButtons.forEach((b) => {
            const active = b.getAttribute('data-tab-target') === target;
            b.className = `px-3 py-1.5 text-xs font-mono rounded-t border-b-2 whitespace-nowrap transition-colors ${
              active
                ? 'border-[#4377df] text-white bg-[#141414]'
                : 'border-transparent text-neutral-400 hover:text-neutral-200'
            }`;
          });
          tabPanels.forEach((panel) => {
            panel.classList.toggle('hidden', panel.getAttribute('data-tab-panel') !== target);
          });
        });
      });
    });
  </script>
</BaseLayout>
