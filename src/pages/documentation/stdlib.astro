<DocsLayout
  title="Standard Library Modules (std.*)"
  description="Complete reference for all 25 standard library modules bundled with Aion: files, OS, time, math, BigInt, JSON, XML, CSV, Regex, Unicode, Crypto, HTTP/1.1 & HTTP/2, WebSockets, SQLite, Reflection, CLI, and Terminal."
  category="Standard Library & API"
  currentSlug="stdlib"
  toc={toc}
  prevPage={{ slug: 'prelude-methods', title: 'Prelude & Built-in Methods' }}
  nextPage={{ slug: 'packages-and-ffi', title: 'Packages, C FFI & Architecture' }}
>
  <Callout type="note" title="Importing Standard Library Modules">
    Import any standard library module with <code>import &lt;name&gt;</code> (e.g. <code>import json</code>) or explicitly with <code>import std.&lt;name&gt;</code>. Only modules you actually import are compiled and linked into your binary.
  </Callout>

