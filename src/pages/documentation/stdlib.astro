  <h2 id="std-json"><code>std.json</code>, <code>std.csv</code> &amp; <code>std.xml</code> — Data Formats</h2>
  <CodeBlock
    title="json_xml_demo.aion"
    code={`import json
import xml

doc := json.parse(r"""{"user": "Ada", "roles": ["admin", "dev"]}""")!!
println(doc.getString("user"), doc["roles"]?.at(0)?.asString())

page := xml.parseHtml("<ul class=nav><li><a href=/docs>Docs<li><a href=/dl>Download</ul>")
for a in page.select("ul.nav li a") {
    println(a.attr("href"), "->", a.text())
}`}
    output={`Ada admin
/docs -> Docs
/dl -> Download`}
  />

