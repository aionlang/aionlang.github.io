  <h2 id="std-sqlite"><code>std.sqlite</code> &amp; <code>std.reflect</code> — Database &amp; Reflection</h2>
  <CodeBlock
    title="sqlite_reflect.aion"
    code={`import sqlite
import reflect

db := sqlite.open(":memory:")!!
db.script("CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT)")
db.exec("INSERT INTO items (name) VALUES (?)", [sqlite.text("Aion")])
println("Row:", db.queryOne("SELECT id, name FROM items")!!.text("name"))
db.close()

type Point(x: Int, y: Int)
p := Point(3, 4)
println("Fields:", reflect.fields(p), "x =", reflect.get(p, "x"))`}
    output={`Row: Aion
Fields: [x: Int, y: Int] x = 3`}
  />

  <MethodTable
    title="import sqlite / import reflect"
    badge="SQLite3 & Runtime Reflection"
    methods={[
      { sig: 'sqlite.open(path) -> Database? (or ":memory:")', returns: 'Database?', desc: 'Opens a SQLite3 database connection. Automatically links -lsqlite3.' },
      { sig: 'Database.script(sql) / .exec(sql, params = []) / .query(sql, params = []) -> List<Row>? / .queryOne(sql, params = []) -> Row? / .transaction { ... } / .close()', returns: 'Bool / List<Row>? / Row?', desc: 'Executes SQL statements with bound parameters (sqlite.int, .float, .text, .blob, .bool, .nil) and reads typed columns via Row.int(col), .text(col), .float(col), .blob(col), .isNull(col).' },
      { sig: 'reflect.typeNames() -> List<String> / reflect.isKnown(name) / reflect.parentOf(name) / reflect.isInstance(x, name)', returns: 'List<String> / Bool / String?', desc: 'Inspects registered program types and inheritance hierarchies at runtime.' },
