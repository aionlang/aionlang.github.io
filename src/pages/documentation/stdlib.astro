      { sig: 'fs.writeText(path, s) / fs.writeLines(path, list) / fs.writeBytes(path, b)', returns: 'Bool', desc: 'Creates or overwrites a file; returns true on success.' },
      { sig: 'fs.appendText(path, s) / fs.appendBytes(path, b)', returns: 'Bool', desc: 'Appends text or bytes to an existing or new file.' },
      { sig: 'fs.exists(p) / fs.isDir(p) / fs.isFile(p) / fs.size(p) -> Int / fs.modified(p) -> Int', returns: 'Bool / Int', desc: 'Queries file existence, kind, size in bytes, and modification time.' },
