import CodeBlock from '../../components/CodeBlock.astro';
import Callout from '../../components/Callout.astro';

const toc = [
  { id: 'scripts-and-structure', label: 'Scripts & Program Structure' },
  { id: 'variables-and-val', label: 'Variables (:=) & Read-Only (val)' },
  { id: 'operators', label: 'Operators & Precedence' },
  { id: 'bitwise-and-literals', label: 'Number Literals & Bitwise Ops', level: 3 },
  { id: 'control-flow', label: 'Control Flow (if, when, loops)' },
  { id: 'ranges', label: 'Ranges (.., ..=, step, downTo)', level: 3 },
