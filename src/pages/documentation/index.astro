---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const toc = [
  { id: 'documentation-sections', label: 'Documentation Sections' },
  { id: 'language-at-a-glance', label: 'Language at a Glance' },
  { id: 'built-in-types-summary', label: 'Built-in Types Summary' },
  { id: 'stdlib-modules-index', label: 'Standard Library Index' },
